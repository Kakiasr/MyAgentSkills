{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kaki-game-development-tools",
  "version": "0.8.1",
  "description": "Kaki 的游戏开发插件，覆盖游戏设计文档、游戏拆解、体验与玩法、系统树、循环图、程序、美术、资产制作和技术美术。",
  "author": {
    "name": "Kakiasr"
  },
  "homepage": "https://github.com/Kakiasr/MyAgentSkills",
  "repository": "https://github.com/Kakiasr/MyAgentSkills",
  "license": "MIT",
  "keywords": [
    "game-analysis",
    "game-design-document",
    "rea",
    "game-design",
    "game-system-design",
    "game-loop-design",
    "game-development",
    "unity",
    "godot",
    "prototype",
    "game-art",
    "technical-art"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Kaki的游戏开发工具",
        "shortDescription": "覆盖设计、程序、美术与技术美术",
        "longDescription": "以统一入口协调游戏拆解、体验与玩法、系统树、循环图及程序美术制作。游戏拆解完整保留REA技能正文、参考与工具集，在此基础上定制游戏机制、数值、结算与例外还原，以证据交接系统树、循环图与开发验收。",
        "developerName": "Kakiasr",
        "category": "Development",
        "capabilities": [
          "Game Design Documents",
          "Game Analysis",
          "Game Design",
          "Game System Design",
          "Game Loop Design",
          "Game Programming",
          "Game Art Design",
          "Game Art Asset Creation",
          "Technical Art"
        ],
        "defaultPrompt": [
          "从设计、程序、美术和技术美术角度规划这个游戏项目。",
          "把这个游戏创意推进为可以开发和制作的最小可玩版本。",
          "评审当前游戏项目，并给出跨专业的下一阶段执行计划。"
        ],
        "brandColor": "#6E4CCB",
        "composerIcon": "./assets/kaki-game-development-tools.svg",
        "logo": "./assets/kaki-game-development-tools.svg"
      }
    }
  }
}
