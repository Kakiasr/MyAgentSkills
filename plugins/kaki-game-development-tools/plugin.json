{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kaki-game-development-tools",
  "version": "0.10.0",
  "description": "Kaki 的游戏开发插件，覆盖游戏拆解与设计文档、体验系统循环、程序与Unity工程，以及细分的美术设计、资产生产、渲染管线和图形性能。",
  "author": {
    "name": "Kakiasr"
  },
  "homepage": "https://github.com/Kakiasr/MyAgentSkills",
  "repository": "https://github.com/Kakiasr/MyAgentSkills",
  "license": "MIT",
  "keywords": [
    "game-analysis",
    "game-design-document",
    "rea",
    "game-design",
    "game-system-design",
    "game-loop-design",
    "game-development",
    "gameplay-programming",
    "software-architecture",
    "unity",
    "unity-editor-tooling",
    "game-testing",
    "godot",
    "prototype",
    "game-art",
    "technical-art"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Kaki的游戏开发工具",
        "shortDescription": "覆盖设计、程序、美术与技术美术",
        "longDescription": "以统一入口协调游戏拆解、体验系统循环及程序美术制作。美术按指导、角色道具、环境、UI、动画、VFX、2D／3D生产、渲染、资产管线和图形性能独立分工；整款游戏拆解默认创建可追溯文档集。",
        "developerName": "Kakiasr",
        "category": "Development",
        "capabilities": [
          "Game Design Documents",
          "Game Analysis",
          "Game Design",
          "Game System Design",
          "Game Loop Design",
          "Game Programming",
          "Game Software Architecture",
          "Gameplay Programming",
          "Unity Project Foundation",
          "Unity Editor Tooling",
          "Game Testing and Validation",
          "Game Art Direction",
          "Character and Environment Art",
          "Game UI Animation and VFX",
          "2D and 3D Asset Production",
          "Rendering Art Pipeline and Graphics Performance"
        ],
        "defaultPrompt": [
          "从设计、程序、美术和技术美术角度规划这个游戏项目。",
          "把这个游戏创意推进为可以开发和制作的最小可玩版本。",
          "完整拆解这款游戏，创建包含体验玩法、循环、逐系统文档、需求、配置和一致性校验的文档集。"
        ],
        "brandColor": "#6E4CCB",
        "composerIcon": "./assets/kaki-game-development-tools.svg",
        "logo": "./assets/kaki-game-development-tools.svg"
      }
    }
  }
}
